@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');
:root{--bg:#090b09;--panel:#111511;--panel2:#171d17;--line:#252d25;--text:#f4f7f1;--muted:#98a198;--green:#b8f52b;--green2:#8acb18}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:"DM Sans",Arial,sans-serif;min-height:100vh}button,input{font:inherit}button{cursor:pointer;color:inherit}.app-shell{display:flex;min-height:100vh;padding-bottom:92px}.sidebar{width:245px;background:#0d100d;border-right:1px solid var(--line);padding:28px 18px;display:flex;flex-direction:column;flex-shrink:0}.brand{display:flex;align-items:center;gap:11px;font-size:23px;font-weight:800;letter-spacing:-1px;margin:0 0 48px 7px}.brand-icon{width:36px;height:36px}.nav-label,.eyebrow{font-size:10px;letter-spacing:1.8px;font-weight:800;color:var(--muted)}.nav-label{margin:0 0 12px 12px}.main-nav{display:grid;gap:6px}.nav-item{background:transparent;border:0;text-align:left;padding:13px 14px;border-radius:10px;color:#aeb7ad;font-weight:600;display:flex;gap:14px;align-items:center}.nav-item span{font-size:14px}.nav-item.active,.nav-item:hover{background:#1b2417;color:var(--green)}.sidebar-bottom{margin-top:auto;display:grid;gap:10px}.outline-btn{border:1px solid #354132;background:transparent;padding:12px;border-radius:10px;color:var(--green);font-weight:700}.privacy-note{font-size:11px;color:#6f796e;text-align:center}.main-content{flex:1;min-width:0}.topbar{height:82px;padding:0 5vw;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:18px}.search-wrap{background:#171c17;border:1px solid #252d25;border-radius:30px;height:42px;display:flex;align-items:center;padding:0 16px;gap:10px;width:min(420px,70%);color:var(--muted)}.search-wrap input{border:0;outline:0;background:transparent;color:white;width:100%;font-size:13px}.icon-btn{border:0;background:transparent;color:#b6c0b4;padding:9px;border-radius:50%;font-size:18px}.icon-btn:hover{color:var(--green);background:#202820}.topbar .icon-btn{margin-left:auto}.mobile-brand{display:none}.content-area{padding:42px 5vw 50px;max-width:1450px;margin:auto}.page-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.page-heading h1{font-size:clamp(30px,4vw,48px);margin:7px 0 5px;letter-spacing:-2px}.muted{color:var(--muted);margin:0;font-size:13px}.primary-btn{background:var(--green);color:#10150b;border:0;border-radius:30px;padding:12px 20px;font-size:13px;font-weight:800;box-shadow:0 5px 24px #b8f52b18}.primary-btn:hover{background:#c9ff4b;transform:translateY(-1px)}.quick-filters{display:flex;gap:9px;margin:0 0 24px}.filter-chip{background:#171d17;border:1px solid #2a3328;color:#b8c1b5;padding:8px 15px;border-radius:22px;font-size:12px}.filter-chip.active{background:var(--green);color:#111;border-color:var(--green);font-weight:800}.section-title{font-size:17px;margin:30px 0 14px}.track-list{display:grid;gap:3px}.track-row{display:grid;grid-template-columns:42px minmax(0,1fr) minmax(100px,.7fr) 70px 36px;gap:14px;align-items:center;padding:9px 12px;border-radius:9px;min-width:0}.track-row:hover{background:#171d17}.track-row.playing{background:#1b2417}.track-art{width:42px;height:42px;object-fit:cover;border-radius:6px;background:#222}.track-main,.track-album{min-width:0}.track-main b,.track-album{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.track-main b{display:block;font-size:13px}.track-main small,.track-album{font-size:11px;color:var(--muted)}.track-time{font-size:11px;color:var(--muted);text-align:right}.track-actions{border:0;background:transparent;color:#8f9a8d;font-size:18px}.empty-state{border:1px dashed #364033;border-radius:18px;padding:48px 20px;text-align:center;color:var(--muted)}.empty-state strong{display:block;color:white;font-size:17px;margin-bottom:8px}.empty-state button{margin-top:15px}.card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:17px}.library-card{background:#121712;border:1px solid #202820;padding:13px;border-radius:13px;cursor:pointer;min-width:0;transition:.18s}.library-card:hover{background:#1b2419;transform:translateY(-3px)}.library-card img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px;background:#222}.library-card b{display:block;margin-top:12px;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.library-card small{color:var(--muted);font-size:11px}.now-playing{position:fixed;z-index:20;inset:0;background:radial-gradient(ellipse at 50% 12%,#26341d 0%,#101710 42%,#080a08 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:38px 24px 95px;animation:playerIn .28s ease}.now-playing.hidden{display:none}@keyframes playerIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}.close-player{position:absolute;top:20px;left:25px;background:transparent;border:0;color:#bdc7b9;font-size:28px}.np-art-wrap{width:min(38vh,340px,75vw);aspect-ratio:1;box-shadow:0 20px 80px #0009;border-radius:8px;overflow:hidden;margin-bottom:28px}.np-art-wrap img{width:100%;height:100%;object-fit:cover}.np-meta{text-align:center;width:min(520px,90vw)}.np-meta h2{font-size:clamp(20px,4vw,29px);margin:8px 0 5px}.progress-area{width:min(560px,90vw);margin:25px 0 13px}.progress-area input{width:100%;accent-color:var(--green);height:4px}.time-row{display:flex;justify-content:space-between;font-size:10px;color:#a2ada0;margin-top:5px}.transport{display:flex;align-items:center;justify-content:center;gap:clamp(8px,2.5vw,24px)}.transport .big{font-size:23px;color:white}.play-button{width:58px;height:58px;border:0;border-radius:50%;background:var(--green);color:#10150b;font-size:21px;padding-left:5px;box-shadow:0 7px 28px #b8f52b33}.seek-skip{width:43px;height:43px;border:0;background:transparent;position:relative;color:#dfe7db}.seek-skip span{font-size:30px;line-height:35px}.seek-skip small{position:absolute;left:14px;top:15px;font-size:9px;font-weight:800}.np-bottom{width:min(560px,90vw);display:flex;justify-content:space-between;align-items:center;margin-top:24px;color:#778273;font-size:9px;letter-spacing:1.4px}.text-btn{background:none;border:0;color:var(--green);font-size:12px}.mini-player{position:fixed;z-index:10;bottom:0;left:0;right:0;height:82px;background:#111611;border-top:1px solid #2b342a;display:flex;align-items:center;padding:0 4vw;gap:25px}.mini-track{display:flex;align-items:center;gap:12px;min-width:0;flex:1;cursor:pointer}.mini-track img{width:48px;height:48px;border-radius:5px;object-fit:cover}.mini-track b,.mini-track small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:240px}.mini-track b{font-size:12px}.mini-track small{color:var(--muted);font-size:10px;margin-top:4px}.mini-controls{display:flex;align-items:center;gap:18px}.mini-controls button{border:0;background:transparent;font-size:17px}.mini-controls button:nth-child(2){background:var(--green);color:#111;border-radius:50%;width:36px;height:36px}.mini-progress{position:absolute;bottom:0;left:0;height:2px;background:#303a2d;width:100%}.mini-progress div{height:100%;background:var(--green);width:0}dialog{background:#121812;color:white;border:1px solid #364132;border-radius:18px;width:min(480px,92vw);padding:24px;box-shadow:0 20px 100px #000b}dialog::backdrop{background:#000b;backdrop-filter:blur(5px)}.dialog-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}.dialog-head h2{margin:0}.setting-row{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid #273027}.setting-row b,.setting-row small{display:block}.setting-row b{font-size:13px}.setting-row small{color:var(--muted);font-size:10px;margin-top:4px}.toggle{border:1px solid #45503f;background:#1d251b;border-radius:20px;padding:7px 15px;color:#aab4a5;font-size:11px}.toggle.on{background:var(--green);color:#111;border-color:var(--green);font-weight:800}.eq-controls{display:grid;gap:8px;padding:15px 0}.eq-controls label,.range-setting{font-size:11px;color:#b5c0b1;display:grid;grid-template-columns:65px 1fr;align-items:center;gap:10px}.eq-controls input,.range-setting input{width:100%;accent-color:var(--green)}.eq-controls.disabled{opacity:.35;pointer-events:none}.range-setting{grid-template-columns:1fr auto;margin:18px 0}.range-setting input{grid-column:1/-1}.settings-footnote{font-size:10px;line-height:1.6;color:#7e8a7b;margin-top:20px}.dialog-input{width:100%;padding:13px 15px;border:1px solid #354032;background:#0b100b;color:white;border-radius:9px;margin-bottom:14px;outline:none}.full{width:100%}.mobile-nav{display:none}
@media(max-width:760px){.sidebar{display:none}.topbar{height:65px;padding:0 17px}.mobile-brand{display:flex;align-items:center;gap:8px;font-size:18px}.mobile-brand img{width:28px}.search-wrap{width:auto;flex:1;height:38px}.content-area{padding:28px 17px 35px}.page-heading{align-items:start;flex-direction:column}.page-heading h1{font-size:34px}.page-heading .primary-btn{align-self:flex-start}.track-row{grid-template-columns:38px minmax(0,1fr) 35px 28px;gap:9px;padding:8px 5px}.track-album{display:none}.track-art{width:38px;height:38px}.mini-player{height:72px;padding:0 13px;gap:12px}.mini-track img{width:42px;height:42px}.mini-track b,.mini-track small{max-width:150px}.mini-controls{gap:10px}.mini-controls button{font-size:14px}.now-playing{padding-bottom:90px}.np-art-wrap{width:min(42vh,76vw)}.transport{gap:7px}.transport .icon-btn{padding:6px;font-size:15px}.transport .big{font-size:18px}.play-button{width:52px;height:52px}.seek-skip{width:35px}.seek-skip span{font-size:26px}.seek-skip small{left:11px;top:14px;font-size:8px}.quick-filters{overflow:auto}.filter-chip{white-space:nowrap}}
